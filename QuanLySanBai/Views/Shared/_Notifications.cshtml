@{
    // TempData keeps messages through a redirect and consumes them when rendered.
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show text-break" role="status">
        <strong>Thành công:</strong> @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Đóng thông báo thành công"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show text-break" role="alert">
        <strong>Có lỗi:</strong> @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Đóng thông báo lỗi"></button>
    </div>
}
