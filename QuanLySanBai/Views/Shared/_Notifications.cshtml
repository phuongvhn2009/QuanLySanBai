@{
    // TempData keeps messages through a redirect and consumes them when rendered.
    var successMessage = TempData["SuccessMessage"] as string;
    var infoMessage = TempData["InfoMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show text-break sb-toast-alert d-flex align-items-start gap-2" role="status" data-auto-dismiss="5500">
        <svg class="flex-shrink-0 mt-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />
        </svg>
        <div class="flex-grow-1"><strong>Thành công:</strong> @successMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Đóng thông báo thành công"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(infoMessage))
{
    <div class="alert alert-warning alert-dismissible fade show text-break sb-toast-alert d-flex align-items-start gap-2" role="status">
        <svg class="flex-shrink-0 mt-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <div class="flex-grow-1"><strong>Thông báo:</strong> @infoMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Đóng thông báo"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show text-break sb-toast-alert d-flex align-items-start gap-2" role="alert">
        <svg class="flex-shrink-0 mt-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
        <div class="flex-grow-1"><strong>Có lỗi:</strong> @errorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Đóng thông báo lỗi"></button>
    </div>
}
