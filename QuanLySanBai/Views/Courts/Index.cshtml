@model List<QuanLySanBai.Models.Entities.San>
@{ ViewData["Title"]="Tìm sân"; var page=(int)ViewBag.Page; }
<h1>Tìm sân</h1><form method="get" class="border p-3 mb-3"><label>Môn <select name="sportId"><option value="">Tất cả</option>@foreach(var m in (List<QuanLySanBai.Models.Entities.MonTheThao>)ViewBag.Sports) { <option value="@m.Id" selected="@(ViewBag.SportId == m.Id)">@m.TenMon</option> }</select></label> <label>Khu vực/địa chỉ <input name="area" value="@ViewBag.Area" /></label> <label>Ngày còn chỗ <input name="date" type="date" value="@(ViewBag.Date?.ToString("yyyy-MM-dd"))" /></label> <button class="btn btn-primary">Tìm</button></form>
@if(Model.Count==0) { <p>Không có sân phù hợp trên trang này.</p> }
@foreach(var s in Model) { <article class="card p-3 mb-3"><h2 class="h5">@s.TenSan · @s.CoSo.TenCoSo</h2><p>@s.CoSo.DiaChi · @s.LoaiSan.MonTheThao.TenMon · @(s.DangBaoTri ? "Đang bảo trì" : "")</p><a asp-action="Details" asp-route-id="@s.Id" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))">Xem lịch và đặt sân</a></article> }
@if(page>1) { <a asp-route-page="@(page-1)" asp-route-area="@ViewBag.Area" asp-route-sportId="@ViewBag.SportId" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))">Trang trước</a> } <a asp-route-page="@(page+1)" asp-route-area="@ViewBag.Area" asp-route-sportId="@ViewBag.SportId" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))">Trang sau</a>
