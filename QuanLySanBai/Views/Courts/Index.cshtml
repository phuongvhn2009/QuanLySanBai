@model List<QuanLySanBai.Models.Entities.San>
@{ ViewData["Title"] = "Tìm sân"; var page = (int)ViewBag.Page; }
<h1>Tìm sân</h1>
<form method="get" class="border p-3 mb-3 rounded bg-light">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Môn thể thao</label>
            <select name="sportId" class="form-select">
                <option value="">Tất cả môn</option>
                @foreach (var m in (List<QuanLySanBai.Models.Entities.MonTheThao>)ViewBag.Sports)
                {
                    <option value="@m.Id" selected="@(ViewBag.SportId == m.Id)">@m.TenMon</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Khu vực / địa chỉ</label>
            <input name="area" value="@ViewBag.Area" class="form-control" placeholder="Quận, huyện hoặc tên đường..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Ngày còn chỗ</label>
            <input name="date" type="date" value="@(ViewBag.Date?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </div>
</form>
@if (Model.Count == 0)
{
    <p class="text-muted">Không có sân phù hợp trên trang này.</p>
}
@foreach (var s in Model)
{
    <article class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-1">@s.TenSan · @s.CoSo.TenCoSo</h2>
                <p class="text-muted mb-0">
                    @s.CoSo.DiaChi · @s.LoaiSan.MonTheThao.TenMon@(s.DangBaoTri ? " · Đang bảo trì" : "")
                </p>
            </div>
            <div>
                <a asp-action="Details" asp-route-id="@s.Id" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))" class="btn btn-outline-primary btn-sm">Xem lịch và đặt sân</a>
            </div>
        </div>
    </article>
}
<div class="d-flex gap-2">
    @if (page > 1)
    {
        <a asp-route-page="@(page - 1)" asp-route-area="@ViewBag.Area" asp-route-sportId="@ViewBag.SportId" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))" class="btn btn-outline-secondary btn-sm">← Trang trước</a>
    }
    <a asp-route-page="@(page + 1)" asp-route-area="@ViewBag.Area" asp-route-sportId="@ViewBag.SportId" asp-route-date="@(ViewBag.Date?.ToString("yyyy-MM-dd"))" class="btn btn-outline-secondary btn-sm">Trang sau →</a>
</div>
