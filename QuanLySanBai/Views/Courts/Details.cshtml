@model QuanLySanBai.ViewModels.CourtCalendar
@{
    ViewData["Title"] = $"{Model.Court.TenSan} — Lịch và đặt sân";
    var walletBalance = ViewBag.WalletBalance as decimal?;
}
<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Danh sách sân</a>
</div>
<h1>@Model.Court.TenSan</h1>
<p class="text-muted">@Model.Court.CoSo.TenCoSo · @Model.Court.CoSo.DiaChi · @Model.Court.LoaiSan.MonTheThao.TenMon</p>
@if (walletBalance.HasValue)
{
    <div class="alert alert-light border py-2 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>Số dư Ví khả dụng của bạn: <strong class="text-success">@walletBalance.Value.ToString("N0") đ</strong> <span class="text-muted small">(nếu ví không đủ khi đặt, hệ thống sẽ tự động tạo mã chuyển khoản VietQR theo mã đơn)</span></span>
        <a asp-controller="Wallet" asp-action="Index" class="btn btn-sm btn-outline-primary">Ví của tôi</a>
    </div>
}
<form method="get" class="row g-2 align-items-center mb-3">
    <input name="id" value="@Model.Court.Id" type="hidden" />
    <div class="col-auto">
        <label class="col-form-label">Ngày sử dụng</label>
    </div>
    <div class="col-auto">
        <input name="date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary">Xem lịch</button>
    </div>
</form>
<p class="small text-muted">Giờ Việt Nam (UTC+7). Kết thúc 00:00 là 24:00 của ngày đã chọn. Giá và chỗ trống được kiểm tra lại khi đặt.</p>
@if (Model.Policy != null)
{
    <details class="border p-3 my-3 rounded config-section">
        <summary class="fw-semibold">Chính sách hủy/đổi: @Model.Policy.TenChinhSach</summary>
        <p class="mt-2 mb-1">@(Model.Policy.ChoPhepDoiLich ? "Cho phép đổi lịch" : "Không cho phép đổi lịch")</p>
        @foreach (var f in Model.Policy.MucPhiHuyDois.OrderBy(f => f.SoGioTuTruocTran))
        {
            <p class="mb-1 text-muted small">@f.SoGioTuTruocTran–@(f.SoGioDenTruocTran?.ToString() ?? "∞") giờ trước buổi: phí hủy @f.TiLePhiHuy.ToString("0.##")%, phí đổi @f.TiLePhiDoi.ToString("0.##")%</p>
        }
    </details>
}
@foreach (var k in Model.Slots)
{
    <article class="card p-3 my-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-1">@k.Start.ToString("HH:mm")–@(k.End == TimeOnly.MinValue ? "24:00" : k.End.ToString("HH:mm"))</h2>
                <p class="mb-0 text-muted">
                    <span class="badge @(k.CanBook ? "bg-success" : k.Status == "Đang giữ chỗ" ? "bg-warning text-dark" : "bg-secondary")">@k.Status</span>
                    @if (k.Price.HasValue)
                    {
                        <span> · Giá @k.Price.Value.ToString("N0") đ · Cọc @(k.Deposit?.ToString("N0") ?? "0") đ</span>
                    }
                    else
                    {
                        <span> · Chưa có giá</span>
                    }
                </p>
            </div>
            @if (k.CanBook)
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var priceVal = k.Price ?? 0m;
                    var depVal = k.Deposit ?? 0m;
                    var hasSplitDeposit = depVal > 0 && depVal < priceVal;
                    var bal = walletBalance ?? 0m;
                    <form asp-controller="Bookings" asp-action="Create" method="post" class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-md-0"
                          data-confirm="Xác nhận đặt khung giờ @k.Start.ToString("HH:mm")–@(k.End == TimeOnly.MinValue ? "24:00" : k.End.ToString("HH:mm")) ngày @Model.Date.ToString("dd/MM/yyyy") (Giá: @priceVal.ToString("N0") đ)?">
                        <input name="CourtId" value="@Model.Court.Id" type="hidden" />
                        <input name="SlotId" value="@k.SlotId" type="hidden" />
                        <input name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" type="hidden" />
                        <select name="PaymentChoice" class="form-select form-select-sm" style="min-width: 270px; width: auto;" aria-label="Phương thức thanh toán">
                            @if (hasSplitDeposit)
                            {
                                <option value="QR_COC">Chuyển khoản đặt cọc VietQR (@depVal.ToString("N0") đ)</option>
                                <option value="QR_FULL">Chuyển khoản toàn bộ VietQR (@priceVal.ToString("N0") đ)</option>
                                <option value="VI_COC">Trừ Ví - Đặt cọc (@depVal.ToString("N0") đ)@(bal < depVal ? " — Không đủ, tự tạo QR" : "")</option>
                                <option value="VI_FULL">Trừ Ví - Toàn bộ (@priceVal.ToString("N0") đ)@(bal < priceVal ? " — Không đủ, tự tạo QR" : "")</option>
                            }
                            else
                            {
                                <option value="QR_FULL">Chuyển khoản VietQR (@priceVal.ToString("N0") đ)</option>
                                <option value="VI_FULL">Trừ Ví (@priceVal.ToString("N0") đ)@(bal < priceVal ? " — Không đủ, tự tạo QR" : "")</option>
                            }
                            <option value="TAI_QUAY">Đặt giữ chỗ — Trả tiền mặt / CK tại quầy</option>
                        </select>
                        <input name="Note" maxlength="1000" class="form-control form-control-sm" style="width: 170px;" placeholder="Ghi chú (tùy chọn)" />
                        <button type="submit" class="btn btn-primary btn-sm text-nowrap">Đặt khung này</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-primary btn-sm">Đăng nhập để đặt</a>
                }
            }
        </div>
    </article>
}
