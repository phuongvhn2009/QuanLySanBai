@model QuanLySanBai.ViewModels.CourtCalendar
@{ ViewData["Title"]=Model.Court.TenSan; }
<h1>@Model.Court.TenSan</h1><p>@Model.Court.CoSo.TenCoSo · @Model.Court.CoSo.DiaChi · @Model.Court.LoaiSan.MonTheThao.TenMon</p>
<form method="get"><input name="id" value="@Model.Court.Id" type="hidden" /><label>Ngày sử dụng <input name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" required /></label> <button class="btn btn-secondary">Xem lịch</button></form>
<p>Giờ Việt Nam (UTC+7). Kết thúc 00:00 là 24:00 của ngày đã chọn. Giá và chỗ trống được kiểm tra lại khi đặt.</p>
@if(Model.Policy!=null) { <details class="border p-3 my-3"><summary>Chính sách hủy/đổi: @Model.Policy.TenChinhSach</summary><p>@(Model.Policy.ChoPhepDoiLich ? "Cho phép đổi lịch" : "Không cho phép đổi lịch")</p>@foreach(var f in Model.Policy.MucPhiHuyDois.OrderBy(f=>f.SoGioTuTruocTran)) { <p>@f.SoGioTuTruocTran–@(f.SoGioDenTruocTran?.ToString() ?? "∞") giờ trước buổi: phí hủy @f.TiLePhiHuy%, phí đổi @f.TiLePhiDoi%</p> }</details> }
@foreach(var k in Model.Slots) { <article class="card p-3 my-2"><h2 class="h5">@k.Start–@(k.End==TimeOnly.MinValue ? "24:00" : k.End.ToString("HH:mm"))</h2><p>@k.Status · Giá @(k.Price?.ToString("N0") ?? "Chưa có") đ · Cọc @(k.Deposit?.ToString("N0") ?? "Chưa có") đ</p>@if(k.CanBook) { @if(User.Identity?.IsAuthenticated==true) { <form asp-controller="Bookings" asp-action="Create" method="post"><input name="CourtId" value="@Model.Court.Id" type="hidden" /><input name="SlotId" value="@k.SlotId" type="hidden" /><input name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" type="hidden" /><label>Ghi chú <input name="Note" maxlength="1000" /></label> <button class="btn btn-primary">Đặt khung này</button></form> } else { <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path+Context.Request.QueryString)">Đăng nhập để đặt</a> } }</article> }
