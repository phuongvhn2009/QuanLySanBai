@model QuanLySanBai.ViewModels.RegisterModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="row g-4 align-items-stretch my-2">
    <div class="col-lg-5">
        <div class="sb-auth-hero">
            <h1 class="display-6 fw-bold mb-3">Cùng nhau<br />ra sân.</h1>
            <p class="text-muted mb-0">Tạo tài khoản nhanh để đặt sân, thanh toán VietQR / Ví và lưu mã QR Check-in trên điện thoại.</p>
            <div class="sb-auth-accent-line"></div>
            <div class="small fw-semibold text-muted">Bóng đá &bull; Cầu lông &bull; Tennis &bull; Bóng rổ &bull; Pickleball</div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-4 p-md-5 h-100">
            <h2 class="h3 mt-0 mb-1">Tạo tài khoản</h2>
            <p class="text-muted small mb-4">Nhập thông tin cá nhân để bắt đầu đặt sân.</p>
            <form method="post" id="registerForm">
                <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
                <partial name="_ProfileFields" model="Model" />
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
                    <a asp-action="Login" class="btn btn-outline-secondary w-100">Đã có tài khoản? Đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const form = document.getElementById('registerForm');
    const emailInput = document.getElementById('Email');
    if (!form || !emailInput) return;
    const gmailRegex = /^[a-zA-Z0-9]+([._%+-][a-zA-Z0-9]+)*@@gmail\.com$/;
    const errorMessage = 'Vui lòng nhập địa chỉ Gmail hợp lệ (example@gmail.com)';
    const errorSpan = form.querySelector('[data-valmsg-for="Email"]');

    function validateGmail() {
        const normalized = (emailInput.value || '').trim().toLowerCase();
        if (emailInput.value !== normalized && normalized.length > 0) {
            emailInput.value = normalized;
        }
        const isValid = gmailRegex.test(normalized);
        if (!isValid) {
            if (errorSpan) {
                errorSpan.textContent = errorMessage;
                errorSpan.classList.remove('field-validation-valid');
                errorSpan.classList.add('field-validation-error');
            }
            emailInput.classList.add('input-validation-error');
        } else {
            if (errorSpan) {
                errorSpan.textContent = '';
                errorSpan.classList.remove('field-validation-error');
                errorSpan.classList.add('field-validation-valid');
            }
            emailInput.classList.remove('input-validation-error');
        }
        return isValid;
    }

    emailInput.addEventListener('blur', validateGmail);
    emailInput.addEventListener('input', () => {
        if (emailInput.classList.contains('input-validation-error')) {
            validateGmail();
        }
    });
    form.addEventListener('submit', event => {
        if (!validateGmail()) {
            event.preventDefault();
            emailInput.focus();
        }
    });
})();
</script>
}
