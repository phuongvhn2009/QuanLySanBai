@model QuanLySanBai.Models.Entities.DonDatSan
@{ var now=(DateTime)ViewBag.ServerNow; var remaining=Math.Max(0,(int)((Model.ThoiGianHetHanGiuCho ?? now)-now).TotalSeconds); }
<h1>Đơn @Model.MaDatSan</h1><p>Trạng thái: @Model.TrangThai</p><p>Khách: @Model.TenKhachHang · @Model.SdtKhachHang</p><p>Tổng hiện tại: @Model.TongTienPhaiTra?.ToString("N0") đ · Cọc yêu cầu: @Model.TienCocYeuCau.ToString("N0") đ</p>
@if(Model.TrangThai=="CHO_THANH_TOAN") { <p role="status">Giữ chỗ còn: <strong id="countdown" data-seconds="@remaining"></strong></p><p>Hạn giữ chỗ theo giờ Việt Nam: @Model.ThoiGianHetHanGiuCho. Hết hạn sẽ tự giải phóng. Chức năng thanh toán thuộc cụm tiếp theo.</p> }
@foreach(var c in Model.ChiTietDatSans) { <div class="card p-3 mb-3"><h2 class="h5">@c.San.TenSan · @c.NgaySuDung · @c.GioBatDau–@(c.GioKetThuc==TimeOnly.MinValue ? "24:00" : c.GioKetThuc.ToString("HH:mm"))</h2><p>@c.TrangThaiSlot · Giá lưu lúc đặt: @c.GiaThue.ToString("N0") đ</p><p>Chính sách lúc đặt: @c.ChinhSachHuyDoi.TenChinhSach</p>@foreach(var f in c.ChinhSachHuyDoi.MucPhiHuyDois.OrderBy(f=>f.SoGioTuTruocTran)) { <p>@f.SoGioTuTruocTran–@(f.SoGioDenTruocTran?.ToString() ?? "∞") giờ: hủy @f.TiLePhiHuy%, đổi @f.TiLePhiDoi%</p> }</div> }
<a asp-action="Index">Đơn của tôi</a>
@section Scripts { <script>const el=document.getElementById('countdown');if(el){const deadline=performance.now()+Number(el.dataset.seconds)*1000;let refreshed=false;function tick(){const left=Math.max(0,Math.ceil((deadline-performance.now())/1000));el.textContent=left>0?Math.floor(left/60)+':'+String(left%60).padStart(2,'0'):'Đã hết hạn giữ chỗ';if(!left&&!refreshed){refreshed=true;setTimeout(()=>location.reload(),35000);}}tick();setInterval(tick,1000);}</script> }
