@model QuanLySanBai.Models.Entities.DonDatSan
@{
    ViewData["Title"] = $"Đơn đặt {Model.MaDatSan}";
    var now = (DateTime)ViewBag.ServerNow;
    var remaining = Math.Max(0, (int)((Model.ThoiGianHetHanGiuCho ?? now) - now).TotalSeconds);
}
<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Đơn của tôi</a>
</div>
<h1>Đơn @Model.MaDatSan</h1>
<p>Trạng thái: <span class="badge @(Model.TrangThai == "CHO_THANH_TOAN" ? "bg-warning text-dark" : Model.TrangThai == "DA_XAC_NHAN" ? "bg-success" : "bg-secondary")">@Model.TrangThai</span></p>
<p>Khách: @Model.TenKhachHang · @Model.SdtKhachHang</p>
<p>Tổng hiện tại: @Model.TongTienPhaiTra?.ToString("N0") đ · Cọc yêu cầu: @Model.TienCocYeuCau.ToString("N0") đ</p>
@if (Model.TrangThai == "CHO_THANH_TOAN")
{
    <div class="alert alert-info py-2" role="status">
        Giữ chỗ còn: <strong id="countdown" data-seconds="@remaining"></strong>
    </div>
    <p class="text-muted small">Hạn giữ chỗ theo giờ Việt Nam: @Model.ThoiGianHetHanGiuCho?.ToString("dd/MM/yyyy HH:mm:ss"). Hết hạn sẽ tự giải phóng. Chức năng thanh toán thuộc cụm tiếp theo.</p>
}
@foreach (var c in Model.ChiTietDatSans)
{
    <div class="card p-3 mb-3">
        <h2 class="h5">@c.San.TenSan · @c.NgaySuDung.ToString("dd/MM/yyyy") · @c.GioBatDau.ToString("HH:mm")–@(c.GioKetThuc == TimeOnly.MinValue ? "24:00" : c.GioKetThuc.ToString("HH:mm"))</h2>
        <p class="mb-1"><span class="badge bg-secondary">@c.TrangThaiSlot</span> · Giá lưu lúc đặt: @c.GiaThue.ToString("N0") đ</p>
        <p class="mb-1 text-muted small">Chính sách lúc đặt: @c.ChinhSachHuyDoi.TenChinhSach</p>
        @foreach (var f in c.ChinhSachHuyDoi.MucPhiHuyDois.OrderBy(f => f.SoGioTuTruocTran))
        {
            <p class="mb-0 text-muted small">@f.SoGioTuTruocTran–@(f.SoGioDenTruocTran?.ToString() ?? "∞") giờ: hủy @f.TiLePhiHuy.ToString("0.##")%, đổi @f.TiLePhiDoi.ToString("0.##")%</p>
        }
    </div>
}
@section Scripts {
    <script>
        const el = document.getElementById('countdown');
        if (el) {
            const deadline = performance.now() + Number(el.dataset.seconds) * 1000;
            let refreshed = false;
            function tick() {
                const left = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));
                el.textContent = left > 0 ? Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') : 'Đã hết hạn giữ chỗ';
                if (!left && !refreshed) {
                    refreshed = true;
                    setTimeout(() => location.reload(), 35000);
                }
            }
            tick();
            setInterval(tick, 1000);
        }
    </script>
}
