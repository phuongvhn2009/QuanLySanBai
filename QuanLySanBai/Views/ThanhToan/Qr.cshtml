@model QuanLySanBai.ViewModels.ThanhToanQrVM
@{
    ViewData["Title"] = $"Thanh toán QR {Model.PaymentCode}";
    var remainingSeconds = Math.Max(0, (int)(Model.ExpiresAt - Model.ServerNow).TotalSeconds);
    var isOrderQr = !Model.IsWalletDeposit && Model.OrderId.HasValue;
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    @if (Model.IsWalletDeposit)
    {
        <a asp-controller="Wallet" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Ví của tôi</a>
    }
    else if (Model.OrderId.HasValue)
    {
        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.OrderId.Value" class="btn btn-outline-secondary btn-sm">← Chi tiết đơn @Model.MaDatSan</a>
    }
    <span class="sb-pill @(Model.Status == "THANH_CONG" ? "sb-pill-success" : Model.IsExpired ? "sb-pill-danger" : "sb-pill-pending")" id="statusBadge">
        @(Model.Status == "THANH_CONG" ? "Đã thanh toán" : Model.IsExpired ? "QR đã hết hạn" : "Trạng thái: Chờ thanh toán")
    </span>
</div>

@if (!Model.IsWalletDeposit)
{
    <div class="booking-stepper" aria-label="Các bước đặt sân">
        <span class="booking-step is-done">✓ 1. Chọn khung giờ</span>
        <span class="booking-step-sep">›</span>
        <span class="booking-step @(Model.Status == "THANH_CONG" ? "is-done" : "is-active")">@(Model.Status == "THANH_CONG" ? "✓ " : "")2. Thanh toán</span>
        <span class="booking-step-sep">›</span>
        <span class="booking-step @(Model.Status == "THANH_CONG" ? "is-active" : "")">3. Nhận QR Check-in</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="alert alert-warning">@Model.WarningMessage</div>
}

<div id="qrCard" data-gateway-id="@Model.GatewayTxId" data-order-id="@Model.OrderId" data-status="@Model.Status">
    @if (Model.Status == "THANH_CONG")
    {
        <div class="card p-4 border-success">
            <h1 class="h4 text-success mb-2">Thanh toán đã được xác nhận thành công!</h1>
            <p class="text-muted mb-3">Hệ thống đã tiếp nhận giao dịch hợp lệ từ ngân hàng và cập nhật trạng thái đơn.</p>
            <div class="d-flex gap-2 flex-wrap">
                @if (Model.OrderId.HasValue)
                {
                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.OrderId.Value" class="btn btn-success">Xem Mã QR Check-in</a>
                }
                @if (Model.PaymentId.HasValue)
                {
                    <a asp-action="HoaDon" asp-route-id="@Model.PaymentId.Value" class="btn btn-outline-secondary">Xem &amp; In hóa đơn</a>
                }
                else if (Model.IsWalletDeposit)
                {
                    <a asp-controller="Wallet" asp-action="Index" class="btn btn-success">Xem số dư ví</a>
                }
            </div>
        </div>
    }
    else if (Model.Status is "THAT_BAI" or "DA_HUY")
    {
        <div class="card p-4 border-danger">
            <h1 class="h4 text-danger mb-2">Yêu cầu thanh toán này không còn hiệu lực (@Model.Status)</h1>
            <p class="text-muted mb-3">Giao dịch đã bị hủy hoặc không thể khớp đơn đặt. Vui lòng không chuyển khoản theo mã QR này.</p>
            @if (Model.OrderId.HasValue)
            {
                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.OrderId.Value" class="btn btn-outline-danger">Quay lại chi tiết đơn</a>
            }
            else if (Model.IsWalletDeposit)
            {
                <a asp-controller="Wallet" asp-action="Index" class="btn btn-outline-danger">Quay lại Ví</a>
            }
        </div>
    }
    else
    {
        <!-- Bố cục 2 cột theo Figma 48:1053 (Thanh toán đặt cọc / VietQR) -->
        <div class="row g-4 align-items-start">
            <div class="col-lg-7">
                <div class="card p-4">
                    @if (isOrderQr)
                    {
                        <h1 class="h4 mt-0 mb-1">Xác nhận thông tin đặt sân</h1>
                        <p class="small text-muted mb-3">Đơn <strong>@Model.MaDatSan</strong> · Mã giao dịch <code>@Model.PaymentCode</code></p>

                        @if (!string.IsNullOrWhiteSpace(Model.TenCoSo))
                        {
                            <div class="fw-bold mb-1">@Model.TenCoSo · @Model.TenSan@(!string.IsNullOrWhiteSpace(Model.TenLoaiSan) ? $" · {Model.TenLoaiSan}" : "")</div>
                        }
                        @if (Model.NgaySuDung.HasValue && Model.GioBatDau.HasValue && Model.GioKetThuc.HasValue)
                        {
                            <div class="small text-muted mb-3">
                                @Model.NgaySuDung.Value.ToString("dd/MM/yyyy") &bull; @Model.GioBatDau.Value.ToString("HH:mm") – @(Model.GioKetThuc.Value == TimeOnly.MinValue ? "24:00" : Model.GioKetThuc.Value.ToString("HH:mm"))
                            </div>
                        }

                        <div class="eyebrow mb-2">CHI PHÍ ĐẶT SÂN</div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Tổng tiền thuê sân</span>
                            <strong>@Model.TongTienPhaiTra.ToString("N0") đ</strong>
                        </div>
                        @if (Model.DaThanhToan > 0)
                        {
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Đã thanh toán trước</span>
                                <strong class="text-success">@Model.DaThanhToan.ToString("N0") đ</strong>
                            </div>
                        }
                        <div class="d-flex justify-content-between py-2 align-items-baseline">
                            <span class="fw-bold">Số tiền cần thanh toán ngay</span>
                            <strong class="fs-5 text-danger">@Model.Amount.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Còn phải thanh toán sau (tại sân / online)</span>
                            <strong>@Model.ConLaiSauGiaoDich.ToString("N0") đ</strong>
                        </div>
                        <hr class="my-3" />
                        <p class="small text-muted mb-1">Lưu ý: Tiền cọc được trừ trực tiếp vào tổng tiền thuê. Bạn chỉ thanh toán phần còn lại tại sân hoặc online.</p>
                        <p class="small text-muted mb-0">Chính sách hủy/đổi áp dụng theo thời điểm đặt sân.</p>
                    }
                    else
                    {
                        <h1 class="h4 mt-0 mb-1">Nạp tiền vào Ví điện tử</h1>
                        <p class="small text-muted mb-3">Mã giao dịch: <code>@Model.PaymentCode</code></p>
                        <div class="d-flex justify-content-between py-2 align-items-baseline">
                            <span class="fw-bold">Số tiền nạp vào ví</span>
                            <strong class="fs-4 text-danger">@Model.Amount.ToString("N0") đ</strong>
                        </div>
                        <hr class="my-3" />
                        <p class="small text-muted mb-0">Số dư ví sẽ tự động cộng ngay sau khi hệ thống đối soát nhận giao dịch hợp lệ từ ngân hàng.</p>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                        <h2 class="h4 mt-0 mb-0">Quét mã QR để thanh toán</h2>
                        @if (!Model.IsExpired)
                        {
                            <span class="sb-pill sb-pill-info"><span class="sb-live-dot" aria-hidden="true"></span>Chờ xác nhận</span>
                        }
                    </div>
                    <div class="small text-muted">Số tiền chuyển khoản</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                        <span class="fs-2 fw-bold text-danger">@Model.Amount.ToString("N0") đ</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="min-height:28px;"
                                onclick="navigator.clipboard?.writeText('@((long)Model.Amount)'); this.textContent='✓ Đã chép'; setTimeout(() => this.textContent='Sao chép', 1500);">
                            Sao chép
                        </button>
                    </div>

                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.QrImageUrl))
                        {
                            <div class="d-inline-block bg-white p-2 border rounded" style="border-radius:8px!important;">
                                <img src="@Model.QrImageUrl" alt="Mã QR VietQR chuyển khoản @Model.PaymentCode" class="img-fluid" style="max-width:230px;" />
                            </div>
                        }
                        else
                        {
                            <div class="p-4 border rounded bg-light text-muted small">Chưa cấu hình tài khoản ngân hàng để hiển thị ảnh QR.</div>
                        }
                    </div>

                    <div class="fw-bold small mb-2">Thông tin chuyển khoản</div>
                    <div class="small text-muted">Ngân hàng / Tài khoản</div>
                    <div class="fw-bold mb-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span>@Model.BankName (@Model.BankCode) · @(string.IsNullOrEmpty(Model.AccountNumber) ? "(Chưa cấu hình)" : Model.AccountNumber)</span>
                            @if (!string.IsNullOrEmpty(Model.AccountNumber))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="min-height:28px;"
                                        onclick="navigator.clipboard?.writeText('@Model.AccountNumber'); this.textContent='✓ Đã chép'; setTimeout(() => this.textContent='Sao chép STK', 1500);">
                                    Sao chép STK
                                </button>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.AccountName))
                        {
                            <div class="small text-muted fw-normal">@Model.AccountName</div>
                        }
                    </div>

                    <div class="small text-muted">Nội dung chuyển khoản</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <strong class="text-primary fs-6" id="transferContent">@Model.TransferContent</strong>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="min-height:28px;"
                                onclick="navigator.clipboard?.writeText('@Model.TransferContent'); this.textContent='✓ Đã chép'; setTimeout(() => this.textContent='Sao chép', 1500);">
                            Sao chép
                        </button>
                    </div>
                    <p class="small text-muted mb-2">Vui lòng giữ nguyên nội dung để hệ thống đối soát giao dịch tự động.</p>
                    @if (!Model.IsExpired)
                    {
                        <div class="sb-info-banner py-2 mb-3 d-flex align-items-center gap-2">
                            <span class="sb-live-dot" aria-hidden="true"></span>
                            <span>Đang tự động chờ ngân hàng xác nhận — không cần tải lại trang.</span>
                        </div>
                    }

                    @if (!Model.IsExpired)
                    {
                        <div class="fw-bold text-danger mb-2">
                            Thời gian giữ chỗ còn lại: <span id="qrCountdown" data-seconds="@remainingSeconds">--:--</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            Mã QR đã quá thời hạn hiển thị. Nếu bạn đã chuyển khoản, hệ thống sẽ đối soát tự động khi nhận được webhook từ ngân hàng.
                        </div>
                    }

                    <p class="small text-muted mb-0">
                        Chỉ xác nhận đơn khi hệ thống nhận được giao dịch hợp lệ. Không tự đánh dấu đã thanh toán chỉ dựa trên ảnh chụp.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('qrCard');
            const status = card?.dataset.status;
            const gatewayId = card?.dataset.gatewayId;
            const countdownEl = document.getElementById('qrCountdown');

            if (countdownEl) {
                const deadline = performance.now() + Number(countdownEl.dataset.seconds) * 1000;
                function tick() {
                    const left = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));
                    countdownEl.textContent = left > 0
                        ? String(Math.floor(left / 60)).padStart(2, '0') + ':' + String(left % 60).padStart(2, '0')
                        : 'Đã hết hạn';
                }
                tick();
                setInterval(tick, 1000);
            }

            if (status !== 'THANH_CONG' && gatewayId) {
                setInterval(async () => {
                    try {
                        const res = await fetch('/ThanhToan/TrangThai/' + gatewayId, { cache: 'no-store' });
                        if (res.ok) {
                            const data = await res.json();
                            if (data.status === 'THANH_CONG' || data.status !== status) {
                                location.reload();
                            }
                        }
                    } catch { }
                }, 5000);
            }
        })();
    </script>
}
