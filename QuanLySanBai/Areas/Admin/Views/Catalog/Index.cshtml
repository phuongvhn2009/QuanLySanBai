@model List<QuanLySanBai.Models.Entities.MonTheThao>
@{ ViewData["Title"] = "Danh mục thể thao"; }
<h1>Danh mục thể thao</h1><p class="text-muted">Mở mục cần chỉnh sửa. Thay đổi sẽ áp dụng cho toàn hệ thống.</p><h2 class="h4">Môn thể thao</h2>
@foreach(var s in Model) { <details class="editor-section"><summary>@s.TenMon <span class="role-label">@(s.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</span></summary><form asp-action="Sport" method="post" class="border p-3 mb-2"><input name="Id" value="@s.Id" type="hidden" /><label>Mã <input name="Code" value="@s.MaMon" required maxlength="50" /></label> <label>Tên <input name="Name" value="@s.TenMon" required maxlength="100" /></label> <label><input name="Active" type="checkbox" value="true" checked="@s.TrangThai" /><input name="Active" type="hidden" value="false" /> Hoạt động</label> <button class="btn btn-primary">Lưu thay đổi</button></form></details> }
<form asp-action="Sport" method="post" class="border p-3 mb-3"><label>Mã mới <input name="Code" required maxlength="50" /></label> <label>Tên <input name="Name" required maxlength="100" /></label><input name="Active" value="true" type="hidden" /><button class="btn btn-primary">Thêm môn</button></form>
<h2 class="h4">Loại sân</h2>@foreach(var t in (List<QuanLySanBai.Models.Entities.LoaiSan>)ViewBag.Types) { <details class="editor-section"><summary>@t.TenLoai <span class="role-label">@t.MonTheThao.TenMon</span></summary><form asp-action="CourtType" method="post" class="border p-3 mb-2"><input name="Id" value="@t.Id" type="hidden" /><label>Môn <select name="SportId">@foreach(var s in Model) { <option value="@s.Id" selected="@(s.Id==t.MonTheThaoId)">@s.TenMon</option> }</select></label> <label>Tên <input name="Name" value="@t.TenLoai" required /></label> <label>Sức chứa <input name="Capacity" type="number" min="1" value="@t.SucChuaNguoi" required /></label><button class="btn btn-primary">Lưu thay đổi</button></form></details> }
<form asp-action="CourtType" method="post" class="border p-3"><label>Môn <select name="SportId">@foreach(var s in Model) { <option value="@s.Id">@s.TenMon</option> }</select></label> <label>Tên loại mới <input name="Name" required maxlength="100" /></label> <label>Sức chứa <input name="Capacity" type="number" min="1" value="10" required /></label> <button class="btn btn-primary">Thêm loại sân</button></form>
