@model List<QuanLySanBai.Models.Entities.MonTheThao>
@using QuanLySanBai.Models.Entities
@using QuanLySanBai.Services
@{
    ViewData["Title"] = "Danh mục thể thao";
    var types = ViewBag.Types as List<LoaiSan> ?? new();
}

<div class="mb-4">
    <h1 class="mb-1">Danh mục thể thao</h1>
    <p class="text-muted mb-0">Quản lý môn thể thao và loại sân (kèm ảnh minh họa mặc định) áp dụng cho toàn hệ thống.</p>
</div>

<div class="card p-4 mb-4">
    <h2 class="h5 mt-0 mb-3">Môn thể thao</h2>
    @foreach (var s in Model)
    {
        <details class="editor-section">
            <summary>@s.TenMon <span class="sb-pill @(s.TrangThai ? "sb-pill-success" : "sb-pill-neutral") ms-2">@(s.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</span></summary>
            <form asp-action="Sport" method="post" class="border p-3 mt-2 mb-1">
                <input name="Id" value="@s.Id" type="hidden" />
                <label>Mã <input name="Code" value="@s.MaMon" required maxlength="50" /></label>
                <label>Tên <input name="Name" value="@s.TenMon" required maxlength="100" /></label>
                <label><input name="Active" type="checkbox" value="true" checked="@s.TrangThai" /><input name="Active" type="hidden" value="false" /> Hoạt động</label>
                <button class="btn btn-primary btn-sm">Lưu thay đổi</button>
            </form>
        </details>
    }
    <form asp-action="Sport" method="post" class="border p-3 mt-2">
        <div class="small fw-semibold text-muted mb-2">Thêm môn thể thao mới</div>
        <label>Mã mới <input name="Code" required maxlength="50" /></label>
        <label>Tên <input name="Name" required maxlength="100" /></label>
        <input name="Active" value="true" type="hidden" />
        <button class="btn btn-primary btn-sm">Thêm môn</button>
    </form>
</div>

<div class="card p-4">
    <h2 class="h5 mt-0 mb-3">Loại sân &amp; Ảnh minh họa mặc định</h2>
    @foreach (var t in types)
    {
        var typeImg = CourtImageResolver.ForCourtType(t, t.MonTheThao);
        <details class="editor-section">
            <summary class="d-flex align-items-center gap-3">
                <span class="sb-mini-thumb"><img src="@typeImg" alt="@t.TenLoai" loading="lazy" /></span>
                <span>
                    <strong>@t.TenLoai</strong>
                    <span class="sb-pill sb-pill-info ms-2">@t.MonTheThao.TenMon</span>
                    <span class="small text-muted ms-1">Sức chứa: @t.SucChuaNguoi người</span>
                </span>
            </summary>
            <form asp-action="CourtType" method="post" class="border p-3 mt-2 mb-1">
                <input name="Id" value="@t.Id" type="hidden" />
                <label>Môn
                    <select name="SportId">
                        @foreach (var s in Model)
                        {
                            <option value="@s.Id" selected="@(s.Id == t.MonTheThaoId)">@s.TenMon</option>
                        }
                    </select>
                </label>
                <label>Tên <input name="Name" value="@t.TenLoai" required /></label>
                <label>Sức chứa <input name="Capacity" type="number" min="1" value="@t.SucChuaNguoi" required /></label>
                <button class="btn btn-primary btn-sm">Lưu thay đổi</button>
            </form>
        </details>
    }
    <form asp-action="CourtType" method="post" class="border p-3 mt-2">
        <div class="small fw-semibold text-muted mb-2">Thêm loại sân mới</div>
        <label>Môn
            <select name="SportId">
                @foreach (var s in Model)
                {
                    <option value="@s.Id">@s.TenMon</option>
                }
            </select>
        </label>
        <label>Tên loại mới <input name="Name" required maxlength="100" /></label>
        <label>Sức chứa <input name="Capacity" type="number" min="1" value="10" required /></label>
        <button class="btn btn-primary btn-sm">Thêm loại sân</button>
    </form>
</div>
