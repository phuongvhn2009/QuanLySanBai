@using QuanLySanBai.Services
@model List<QuanLySanBai.Models.Entities.NguoiDung>
@{ ViewData["Title"]="Người dùng"; var actor=AccessService.UserId(User); }
<div class="page-heading"><div><h1>Người dùng</h1><p class="text-muted">Tra cứu và quản lý trạng thái tài khoản.</p></div></div>
<form method="get" class="card p-3 mb-4"><label for="search">Tên hoặc số điện thoại</label><div class="action-row"><input id="search" name="search" value="@Context.Request.Query["search"]" placeholder="Nhập để tìm tài khoản" /><button class="btn btn-primary">Tìm kiếm</button><a class="btn btn-outline-secondary" asp-action="Users">Xóa bộ lọc</a></div></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Người dùng</th><th>Liên hệ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach(var u in Model) { <tr><td>@u.HoVaTen @if(u.Id==actor) { <span class="role-label">Bạn</span> }</td><td>@u.SoDienThoai<br /><span class="text-muted small">@u.Email</span></td><td><span class="status-label">@(u.TrangThai ? "Hoạt động" : "Đã khóa")</span></td><td class="text-end">@if(u.Id!=actor) { <form asp-action="SetActive" method="post" data-confirm="@(u.TrangThai ? "Khóa tài khoản này? Người dùng sẽ bị đăng xuất và không thể đăng nhập." : "Mở khóa để tài khoản này đăng nhập lại?")"><input name="id" value="@u.Id" type="hidden" /><input name="active" value="@((!u.TrangThai).ToString().ToLowerInvariant())" type="hidden" /><button class="btn @(u.TrangThai ? "btn-outline-danger" : "btn-outline-primary")">@(u.TrangThai ? "Khóa tài khoản" : "Mở khóa")</button></form> } else { <span class="text-muted small">Đang đăng nhập</span> }</td></tr> }
</tbody></table></div></div><p class="text-muted small mt-3">Hiển thị tối đa 200 tài khoản. Dùng tìm kiếm để thu hẹp kết quả.</p>
