@{ ViewData["Title"] = "Tổng quan quản trị"; }
<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">QUẢN TRỊ HỆ THỐNG</p>
        <h1>Tổng quan</h1>
        <p class="text-muted mb-0">Chọn công việc quản trị bạn muốn thực hiện.</p>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6 col-lg-3">
        <article class="card sb-card-interactive h-100 p-4 d-flex flex-column">
            <div class="sb-pill sb-pill-info mb-3" style="width:fit-content;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                Kiểm duyệt
            </div>
            <h2 class="h5 mt-0">Duyệt cơ sở</h2>
            <p class="text-muted small">Kiểm tra thông tin và duyệt cơ sở trước khi nhận đặt sân.</p>
            <a class="btn btn-primary mt-auto" href="/Admin/Management/Facilities">Xem cơ sở</a>
        </article>
    </div>
    <div class="col-md-6 col-lg-3">
        <article class="card sb-card-interactive h-100 p-4 d-flex flex-column">
            <div class="sb-pill sb-pill-neutral mb-3" style="width:fit-content;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                Tài khoản
            </div>
            <h2 class="h5 mt-0">Người dùng</h2>
            <p class="text-muted small">Tìm tài khoản, kiểm tra trạng thái và khóa hoặc mở khóa.</p>
            <a class="btn btn-outline-primary mt-auto" href="/Admin/Management/Users">Quản lý người dùng</a>
        </article>
    </div>
    <div class="col-md-6 col-lg-3">
        <article class="card sb-card-interactive h-100 p-4 d-flex flex-column">
            <div class="sb-pill sb-pill-success mb-3" style="width:fit-content;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                Hệ thống
            </div>
            <h2 class="h5 mt-0">Danh mục thể thao</h2>
            <p class="text-muted small">Quản lý các môn thể thao và loại sân của hệ thống.</p>
            <a class="btn btn-outline-primary mt-auto" href="/Admin/Catalog">Quản lý danh mục</a>
        </article>
    </div>
    <div class="col-md-6 col-lg-3">
        <article class="card sb-card-interactive h-100 p-4 d-flex flex-column">
            <div class="sb-pill sb-pill-pending mb-3" style="width:fit-content;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                Đối soát
            </div>
            <h2 class="h5 mt-0">Rút tiền &amp; Webhook</h2>
            <p class="text-muted small">Duyệt yêu cầu rút tiền từ ví và đối soát nhật ký Webhook SePay.</p>
            <a class="btn btn-outline-primary mt-auto" href="/Admin/Payouts">Xem tài chính</a>
        </article>
    </div>
</div>
