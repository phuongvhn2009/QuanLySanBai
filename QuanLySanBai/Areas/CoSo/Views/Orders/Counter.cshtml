@model QuanLySanBai.ViewModels.CounterForm
@{ ViewData["Title"]="Đặt tại quầy"; }
<h1>Đặt sân tại quầy</h1><p class="text-muted">Giá, cọc và chỗ trống được kiểm tra lại khi tạo đơn. Đơn chưa đạt cọc sẽ hết hạn giữ chỗ.</p><form method="post" class="card p-4 col-lg-7"><input asp-for="FacilityId" type="hidden" /><label for="CourtId">Sân</label><select asp-for="CourtId">@foreach(var s in (List<QuanLySanBai.Models.Entities.San>)ViewBag.Courts){<option value="@s.Id">@s.TenSan</option>}</select><label for="Date">Ngày sử dụng</label><input asp-for="Date" type="date" /><label for="SlotId">Khung giờ</label><select asp-for="SlotId">@foreach(var k in (List<QuanLySanBai.Models.Entities.KhungGioMacDinh>)ViewBag.Slots){<option value="@k.Id">@k.GioBatDau–@(k.GioKetThuc==TimeOnly.MinValue ? "24:00" : k.GioKetThuc.ToString())</option>}</select><label for="Name">Tên khách</label><input asp-for="Name" required /><label for="Phone">Số điện thoại</label><input asp-for="Phone" required /><button class="btn btn-primary mt-3">Tạo đơn giữ chỗ</button></form>
