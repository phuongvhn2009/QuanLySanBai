@model QuanLySanBai.ViewModels.OperationList
@{ ViewData["Title"]="Đơn đặt tại cơ sở"; }
<div class="page-heading"><div><a href="/CoSo">← Cơ sở của tôi</a><h1 class="mt-3">Lịch và đơn đặt</h1></div>@if((bool)ViewBag.CanCreate){<a class="btn btn-primary" asp-action="Counter" asp-route-facilityId="@Model.FacilityId">Đặt tại quầy</a>}</div>
<form method="get" class="card p-3 mb-3"><input name="facilityId" value="@Model.FacilityId" type="hidden" /><div class="action-row"><label>Ngày sử dụng <input name="date" type="date" value="@Model.Date?.ToString("yyyy-MM-dd")" /></label><label>Điện thoại <input name="phone" value="@Model.Phone" /></label><label>Trạng thái <select name="status"><option value="">Tất cả</option>@foreach(var s in new[]{"CHO_THANH_TOAN","DA_XAC_NHAN","DANG_SU_DUNG","HOAN_THANH","DA_HUY","HET_HAN"}){<option value="@s" selected="@(s==Model.Status)">@QuanLySanBai.Services.OrderLabels.Status(s)</option>}</select></label><button class="btn btn-primary">Lọc đơn</button></div></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Khách</th><th>Sân / thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var d in Model.Orders){<tr><td>@d.TenKhachHang<br />@d.SdtKhachHang</td><td>@foreach(var c in d.ChiTietDatSans){<p class="mb-0">@c.San.TenSan · @c.NgaySuDung · @c.GioBatDau–@(c.GioKetThuc==TimeOnly.MinValue ? "24:00" : c.GioKetThuc.ToString())</p>}</td><td>@QuanLySanBai.Services.OrderLabels.Status(d.TrangThai)</td><td><a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@d.Id">Xem đơn</a></td></tr>}</tbody></table></div>
<p>Trang @Model.Page / @Model.TotalPages</p><div class="action-row">@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-facilityId="@Model.FacilityId" asp-route-page="@(Model.Page-1)" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-phone="@Model.Phone">Trang trước</a>}@if(Model.Page<Model.TotalPages){<a class="btn btn-outline-secondary" asp-route-facilityId="@Model.FacilityId" asp-route-page="@(Model.Page+1)" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-phone="@Model.Phone">Trang sau</a>}</div>
