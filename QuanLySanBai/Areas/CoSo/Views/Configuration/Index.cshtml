@model QuanLySanBai.ViewModels.FacilityDashboard
@{ var c=Model.Facility; ViewData["Title"]="Cấu hình cơ sở"; }
<h1>@c.TenCoSo</h1><p>@c.DiaChi · @(c.TrangThaiDuyet=="DA_DUYET" ? "Đã duyệt" : c.TrangThaiDuyet=="TU_CHOI" ? "Đã từ chối" : "Chờ duyệt") · @(c.DangHoatDong ? "Hoạt động" : "Ngừng hoạt động")</p>
<nav class="action-row my-3"><a asp-action="Facility" asp-route-id="@c.Id" class="btn btn-outline-secondary">Thông tin cơ sở</a> <a asp-controller="Members" asp-action="Index" asp-route-coSoId="@c.Id" class="btn btn-outline-secondary">Nhân viên</a></nav>
<details class="config-section" name="configuration" open><summary>Sân</summary><h2 class="h4">Sân</h2><a class="btn btn-primary my-3" asp-action="Court" asp-route-facilityId="@c.Id">Thêm sân</a>@foreach(var s in Model.Courts) { <p>@s.TenSan · @s.LoaiSan.TenLoai · @(s.DangHoatDong ? "Hoạt động" : "Ngừng")@(s.DangBaoTri ? " · Bảo trì" : "") · <a asp-action="Court" asp-route-facilityId="@c.Id" asp-route-id="@s.Id">Sửa / ngừng sân</a></p> }
</details><details class="config-section" name="configuration"><summary>Lịch tuần</summary><h2 class="h4">Lịch tuần</h2><p>Thứ Hai = 1, Chủ nhật = 7. Ngày chưa cấu hình dùng giờ mặc định @c.GioMoCua–@c.GioDongCua. Kết thúc 00:00 nghĩa là 24:00.</p>
@foreach(var h in Model.Hours) { <p>Thứ @h.ThuTrongTuan: @(h.NghiCaNgay ? "Nghỉ" : $"{h.GioMoCua}–{h.GioDongCua}")</p> }
<form asp-action="Hours" method="post" class="border p-3 mb-3"><input name="FacilityId" value="@c.Id" type="hidden" /><label>Thứ <input name="Weekday" type="number" min="1" max="7" value="1" required /></label> <label>Mở <input name="Open" type="time" value="06:00" required /></label> <label>Đóng <input name="Close" type="time" value="22:00" required /></label> <label><input name="Closed" type="checkbox" value="true" /> Nghỉ cả ngày</label> <button class="btn btn-primary">Lưu ngày trong tuần</button></form>
</details><details class="config-section" name="configuration"><summary>Khung giờ</summary><h2 class="h4">Khung giờ</h2>
@foreach(var k in Model.Slots) {
    var slotUsed = Model.Prices.Any(p => p.KhungGioId == k.Id);
    <div class="border p-2 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <form asp-action="Slot" method="post" class="action-row m-0">
            <input name="FacilityId" value="@c.Id" type="hidden" />
            <input name="Id" value="@k.Id" type="hidden" />
            <span class="fw-semibold">#@k.Id:</span>
            <label class="m-0">Bắt đầu <input name="Start" type="time" value="@k.GioBatDau.ToString("HH:mm")" required disabled="@slotUsed" /></label>
            <label class="m-0">Kết thúc <input name="End" type="time" value="@k.GioKetThuc.ToString("HH:mm")" required disabled="@slotUsed" /></label>
            @if(!slotUsed) { <button class="btn btn-outline-primary">Lưu khung</button> } else { <span class="text-muted small">Đã gắn bảng giá</span> }
        </form>
        @if(!slotUsed) {
            <form asp-action="DeleteSlot" method="post" class="d-inline m-0" data-confirm="Xóa khung giờ #@k.Id (@k.GioBatDau–@k.GioKetThuc)?">
                <input name="facilityId" value="@c.Id" type="hidden" />
                <input name="id" value="@k.Id" type="hidden" />
                <button class="btn btn-outline-danger">Xóa khung</button>
            </form>
        }
    </div>
}
<form asp-action="Slot" method="post" class="border p-3 mb-3"><input name="FacilityId" value="@c.Id" type="hidden" /><label>Bắt đầu <input name="Start" type="time" required /></label> <label>Kết thúc <input name="End" type="time" required /></label> <button class="btn btn-primary">Thêm khung</button></form>
</details><details class="config-section" name="configuration"><summary>Giá và tiền cọc</summary><h2 class="h4">Giá và tiền cọc</h2>
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="mb-0">Giá đã dùng được giữ nguyên. Tắt giá cũ và tạo giá mới để thay đổi.</p>
    <label class="d-inline-flex flex-row align-items-center m-0"><input type="checkbox" id="toggle-stopped-prices" /> Hiển thị cả mức giá đã tắt</label>
</div>
@foreach(var group in Model.Prices.GroupBy(p => p.San.TenSan)) {
    <div class="mb-3 price-group">
        <h3 class="h6 fw-bold mb-2">@group.Key</h3>
        @foreach(var p in group.OrderBy(p => p.ThuTrongTuan).ThenBy(p => p.KhungGio.GioBatDau)) {
            <div class="border p-2 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2 price-row @(p.DangApDung ? "" : "price-stopped d-none")">
                <span>@p.KhungGio.GioBatDau–@p.KhungGio.GioKetThuc · thứ @p.ThuTrongTuan · @(p.NgayHieuLucDen.HasValue ? $"{p.NgayHieuLucTu} đến {p.NgayHieuLucDen}" : $"từ {p.NgayHieuLucTu} (Không thời hạn)") · @p.GiaThue.ToString("N0") đ · cọc @p.TienCocToiThieu.ToString("N0") đ · <span class="status-label">@(p.DangApDung ? "Áp dụng" : "Đã tắt")</span></span>
                @if(p.DangApDung) { <form asp-action="StopPrice" method="post" class="d-inline m-0" data-confirm="Tắt mức giá này? Sau khi tắt sẽ không thể bật lại mà phải tạo mức giá mới."><input name="facilityId" value="@c.Id" type="hidden" /><input name="id" value="@p.Id" type="hidden" /><button class="btn btn-outline-danger">Tắt giá</button></form> }
            </div>
        }
    </div>
}
<form asp-action="Price" method="post" class="border p-3 mb-3"><input name="FacilityId" value="@c.Id" type="hidden" />
<label>Sân <select name="CourtId">@foreach(var s in Model.Courts) { <option value="@s.Id">@s.TenSan</option> }</select></label> <label>Khung <select name="SlotId">@foreach(var k in Model.Slots) { <option value="@k.Id">@k.GioBatDau–@k.GioKetThuc</option> }</select></label>
<label>Thứ <input name="Weekday" type="number" min="1" max="7" value="1" required /></label> <label>Giá <input name="Price" type="number" min="0" step="0.01" required /></label> <label>Cọc <input name="Deposit" type="number" min="0" step="0.01" required /></label> <label>Từ <input name="From" type="date" required /></label> <label>Đến <input name="Until" type="date" /></label> <button class="btn btn-primary">Thêm giá</button></form>
</details><details class="config-section" name="configuration"><summary>Chính sách hủy/đổi</summary><h2 class="h4">Chính sách hủy/đổi</h2><a class="btn btn-primary my-3" asp-action="Policy" asp-route-facilityId="@c.Id">Thêm chính sách</a>@foreach(var p in Model.Policies) { <div class="border p-3 mb-3"><h3 class="h6">@p.TenChinhSach · @(p.NgayHieuLucDen.HasValue ? $"{p.NgayHieuLucTu} đến {p.NgayHieuLucDen}" : $"từ {p.NgayHieuLucTu} (Không thời hạn)")</h3>@foreach(var f in p.MucPhiHuyDois.OrderBy(f=>f.SoGioTuTruocTran)) { <p>@f.SoGioTuTruocTran–@(f.SoGioDenTruocTran?.ToString() ?? "∞") giờ trước buổi: hủy @f.TiLePhiHuy%, đổi @f.TiLePhiDoi%</p> }<form asp-action="ClosePolicy" method="post" data-confirm="Đóng hiệu lực phiên bản chính sách này?"><input name="facilityId" value="@c.Id" type="hidden" /><input name="id" value="@p.Id" type="hidden" /><label>Đóng hiệu lực đến hết ngày <input name="until" type="date" value="@(p.NgayHieuLucDen?.ToString("yyyy-MM-dd"))" required /></label> <button class="btn btn-secondary">Đóng phiên bản</button></form></div> }
</details><details class="config-section" name="configuration"><summary>Khóa sân</summary><h2 class="h4">Khóa sân</h2>@foreach(var l in Model.Locks) { <div class="border p-2 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2"><span>@l.San.TenSan · @l.BatDauLuc–@l.KetThucLuc · @l.LyDo · <span class="status-label">@(l.TrangThai=="DANG_AP_DUNG" ? "Đang khóa" : "Đã gỡ khóa")</span></span> @if(l.TrangThai=="DANG_AP_DUNG") { <form asp-action="CancelLock" method="post" class="d-inline m-0" data-confirm="Gỡ khóa sân trong khoảng thời gian này?"><input name="facilityId" value="@c.Id" type="hidden" /><input name="id" value="@l.Id" type="hidden" /><button class="btn btn-secondary">Gỡ khóa</button></form> }</div> }
<form asp-action="Lock" method="post" class="border p-3"><input name="FacilityId" value="@c.Id" type="hidden" /><label>Sân <select name="CourtId">@foreach(var s in Model.Courts) { <option value="@s.Id">@s.TenSan</option> }</select></label> <label>Bắt đầu (giờ VN) <input name="Start" type="datetime-local" required /></label> <label>Kết thúc <input name="End" type="datetime-local" required /></label> <label>Lý do <input name="Reason" required maxlength="500" /></label> <button class="btn btn-primary">Khóa sân</button></form>
</details>
@section Scripts {
<script>
document.getElementById('toggle-stopped-prices')?.addEventListener('change', e => {
    document.querySelectorAll('.price-stopped').forEach(el => el.classList.toggle('d-none', !e.target.checked));
});
</script>
}
